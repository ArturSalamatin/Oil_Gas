{
  "model": "claude-opus-5-5[1M]",
  "effortLevel": "max",
  "permissions": {
    "allow": [
      "Bash(*)",
      "PowerShell(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*add *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-git-add-all.sh"
          },
          {
            "type": "command",
            "if": "PowerShell(*git*add *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-git-add-all.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-ai-attribution.sh"
          }
        ]
      }
    ]
  }
}
