{
  "model": "claude-opus-4-6",
  "effortLevel": "max",
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "11500"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "PowerShell(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git add .)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-git-add-all.sh"
          },
          {
            "type": "command",
            "if": "Bash(git add -A*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-git-add-all.sh"
          },
          {
            "type": "command",
            "if": "PowerShell(git add .)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-git-add-all.sh"
          },
          {
            "type": "command",
            "if": "PowerShell(git add -A*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-git-add-all.sh"
          }
        ]
      }
    ]
  }
}
